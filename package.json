{
  "name": "rental-scheduler",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "build:prod": "next build",
    "start": "next start -p ${PORT:-3000}",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
