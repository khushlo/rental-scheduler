generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id          Int        @id @default(autoincrement())
  name        String
  subdomain   String     @unique
  domain      String?
  settings    Json?
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt
  
  // Store-related fields for multi-tenant store management
  storeName     String?
  storeTagline  String?
  storeAddress  String?
  storePhone    String?
  storeEmail    String?
  storeWebsite  String?
  storeLogo     String?
  storeTheme    String?   @default("light")
  storeCurrency String?   @default("USD")
  storeTimezone String?   @default("America/New_York")
  
  // Business details
  businessLicense String?
  taxNumber       String?
  bankDetails     Json?
  
  bookings  Booking[]
  customers Customer[]
  products  Product[]

  @@map("tenants")
}

model Product {
  id           Int           @id @default(autoincrement())
  name         String
  quantity     Int           @default(1)
  rentPrice    Float
  status       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  tenantId     Int           @default(1)
  bookingItems BookingItem[]
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("products")
}

model Customer {
  id        Int       @id @default(autoincrement())
  name      String
  phone1    String
  phone2    String?
  address   String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenantId  Int       @default(1)
  bookings  Booking[]
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("customers")
}

model Booking {
  id             Int           @id @default(autoincrement())
  startDate      DateTime
  endDate        DateTime
  startTime      String        @default("09:00")
  endTime        String        @default("17:00")
  totalAmount    Float
  advancePayment Float         @default(0)
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  customerId     Int
  eventDate      DateTime?
  tenantId       Int           @default(1)
  items          BookingItem[]
  customer       Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@map("bookings")
}

model BookingItem {
  id            Int       @id @default(autoincrement())
  quantity      Int       @default(1)
  pricePerDay   Float
  subtotal      Float
  notes         String?
  bookingId     Int
  productId     Int
  itemEndDate   DateTime?
  itemEndTime   String?
  itemStartDate DateTime?
  itemStartTime String?
  booking       Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  product       Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("booking_items")
}
